{
  "name": "ai-works",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:web": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "verify:sdd": "node scripts/verify-openspec-change.mjs --change openspec/changes/task-016-bootstrap-repository-publication",
